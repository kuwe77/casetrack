# Worker only. Never prefix secrets with VITE_ or put them in the browser/Vercel.
CASETRACK_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
CASETRACK_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
CASETRACK_WORKER_TOKEN=GENERATE_IN_THE_WHATSAPP_TAB
CASETRACK_WHATSAPP_ACCOUNT_ID=VERIFY_WITH_ZERNIO_ACCOUNTS_LIST
# Uses the key saved by zernio auth:login in ~/.zernio/config.json.
# An existing ZERNIO_API_KEY environment variable takes precedence; verify it is the right account.
HERMES_SOURCE=/absolute/path/to/hermes-agent
HERMES_PYTHON=/absolute/path/to/hermes-agent/.venv/bin/python
# Optional: use an existing configured Hermes provider/model, including Meta Muse.
# CASETRACK_MODEL_PROVIDER=your-configured-provider
# CASETRACK_MODEL=your-configured-model
