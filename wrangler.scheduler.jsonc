{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "casetrack-scheduler",
  "main": "cloudflare/scheduler.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "casetrack",
      "database_id": "384e3921-ab85-437b-a53c-3ba862fb2870",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "account_id": "9f8565110d91894eeb29824a2ca95fd0",
  "workers_dev": false,
  "preview_urls": false
}
