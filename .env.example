# Local secrets are read from .dev.vars (never committed).
# Required: AUTH_SECRET=<cryptographically random value, at least 32 characters>
# Optional production canonical origin: APP_ORIGIN=https://your-project.pages.dev
# Bindings and database IDs are configured in wrangler.jsonc.
# Optional document allowances (positive integers; defaults shown):
# DOCUMENT_MAX_FIRM_BYTES=104857600
# DOCUMENT_MAX_FIRM_FILES=100
# DOCUMENT_MAX_TOTAL_BYTES=1073741824
# DOCUMENT_MAX_TOTAL_FILES=1000
