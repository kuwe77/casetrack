{
  "name": "jurisync",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run src tests",
    "start": "vite preview --host 127.0.0.1 --port 4173",
    "dev:api": "wrangler pages dev dist --port 8788",
    "db:local": "wrangler d1 migrations apply casetrack --local",
    "deploy": "npm run build && wrangler pages deploy dist --project-name casetrack",
    "test:integration": "node scripts/test-cloudflare.mjs",
    "dev:scheduler": "wrangler dev --config wrangler.scheduler.jsonc --port 8789 --test-scheduled",
    "deploy:scheduler": "wrangler deploy --config wrangler.scheduler.jsonc"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.54.0",
    "radix-ui": "^1.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.2"
  },
  "license": "MIT",
  "description": "Conveyancing case management with private firm workspaces and an agent API on Cloudflare.",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kuwe77/casetrack.git"
  }
}
